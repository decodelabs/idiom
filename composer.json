{
    "name": "decodelabs/idiom",
    "description": "Lightwight text to HTML parser",
    "type": "library",
    "keywords": [
        "tags",
        "markup",
        "html"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Tom Wright",
            "email": "tom@inflatablecookie.com"
        }
    ],
    "require": {
        "php": "^8.4",

        "decodelabs/coercion": "^0.3.5",
        "decodelabs/tagged": "^0.21"
    },
    "require-dev": {
        "decodelabs/chorus": ">0",
        "decodelabs/metamorph": "^0.8",
        "decodelabs/phpstan-decodelabs": "^0.7"
    },
    "conflict": {
        "decodelabs/metamorph": "<0.8"
    },
    "autoload": {
        "psr-4": {
            "DecodeLabs\\Idiom\\": "src/Idiom",
            "DecodeLabs\\Metamorph\\Handler\\": "src/Metamorph"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "0.3.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
